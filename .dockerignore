# Keep the image small and secrets out of it. Dockerfile does `COPY . .`;
# without this file the Windows .venv (hundreds of MB), node_modules, local
# media/ and the real .env were all baked into every build.
.git
.gitignore
.venv
venv
__pycache__
**/__pycache__
*.py[cod]
.pytest_cache
.coverage
htmlcov
.env
.env.*
!.env.example
media
frontend/node_modules
frontend/dist
frontend/.vite
.claude
.vscode
.idea
*.log

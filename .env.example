# ========== Core ==========
# При DJANGO_DEBUG=0 сервер откажется стартовать с этим дефолтным секретом.
DJANGO_SECRET_KEY=dev-secret-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ========== Security (см. docs/SECURITY.md) ==========
# Общий токен доступа ко всему /api и /media. Пусто = открыто (только localhost!).
# Фронт спросит его один раз и сохранит в HttpOnly-cookie.
APP_ACCESS_TOKEN=
# Лимиты на IP: любые запросы к API и создание новых эпизодов (каждый = деньги на Whisper/Claude).
API_RATE_LIMIT=300/min
UPLOAD_RATE_LIMIT=20/hour
# Origin'ы SPA для CORS в проде (в DEBUG открыто). Пусто = только same-origin.
CORS_ALLOWED_ORIGINS=
# За TLS-прокси (nginx/Caddy) поставь 1, чтобы cookie получила флаг Secure.
DJANGO_SECURE_PROXY_SSL_HEADER=0

# ========== Database ==========
POSTGRES_DB=podcastpack
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ========== Redis / Celery ==========
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ========== External APIs ==========
# Whisper transcription — pick ONE of the variants below.
#
# === Вариант 1: OpenAI (платный, $0.006/мин аудио) ===
# OPENAI_API_KEY=sk-...
# WHISPER_BASE_URL=         # пусто = OpenAI default
# WHISPER_MODEL=whisper-1
#
# === Вариант 2: Groq (бесплатный free tier, лимит 7200 секунд аудио в час) ===
# OPENAI_API_KEY=gsk_...     # получить на console.groq.com/keys
# WHISPER_BASE_URL=https://api.groq.com/openai/v1
# WHISPER_MODEL=whisper-large-v3-turbo
OPENAI_API_KEY=sk-...
WHISPER_BASE_URL=
WHISPER_MODEL=whisper-1

# Anthropic — без альтернатив, нужен реальный ключ
ANTHROPIC_API_KEY=sk-ant-...

# Языки подкастов. Пусто = любой язык, который определит Whisper (Claude
# пишет артефакты на языке подкаста). Ограничить: TRANSCRIPTION_ALLOWED_LANGUAGES=en,ru,uk
TRANSCRIPTION_ALLOWED_LANGUAGES=

# Лимит regenerate на один артефакт в минуту (SPEC §6.5). 0 = выключить.
REGENERATE_LIMIT_PER_MINUTE=3

# ========== Storage ==========
# MVP: local volume. Production: swap for S3.
MEDIA_ROOT=/app/media
ARTIFACTS_ROOT=/app/media/artifacts

# ========== Limits ==========
MAX_UPLOAD_SIZE_MB=500
MAX_EPISODE_DURATION_MIN=180

# ========== Feature flags for MVP ==========
ENABLE_DIARIZATION=0
ENABLE_FACE_TRACKING=0
ENABLE_AI_THUMBNAILS=0
